    "# ==========================================\n",
    "# 1. IMPORTS & HELPER FUNCTIONS\n",
    "# ==========================================\n",
    "import getpass\n",
    "import os\n",
    "import re\n",
    "import xml.etree.ElementTree as ET\n",
    "import requests\n",
    "from requests.auth import HTTPBasicAuth\n",
    "\n",
    "SOAP_REPLACE_TEMPLATE = \"\"\"<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n",
    "  <soap:Body>\n",
    "    <ucp:updateRequest xmlns:ucp=\"http://www.loc.gov/zing/srw/update/\" xmlns:srw=\"http://www.loc.gov/zing/srw/\" xmlns:diag=\"http://www.loc.gov/zing/srw/diagnostic/\">\n",
    "      <srw:version>1.0</srw:version>\n",
    "      <ucp:action>info:srw/action/1/replace</ucp:action>\n",
    "      <ucp:recordIdentifier>gnd:gnd{target_ppn}</ucp:recordIdentifier>\n",
    "      <srw:record>\n",
    "        <srw:recordPacking>xml</srw:recordPacking>\n",
    "        <srw:recordSchema>MARC21-xml</srw:recordSchema>\n",
    "        <srw:recordData>\n",
    "          {marc_record_str}\n",
    "        </srw:recordData>\n",
    "      </srw:record>\n",
    "      <srw:extraRequestData>\n",
    "        <authenticationToken>{username}/{password}</authenticationToken>\n",
    "      </srw:extraRequestData>\n",
    "    </ucp:updateRequest>\n",
    "  </soap:Body>\n",
    "</soap:Envelope>\"\"\"\n",
    "\n",
    "def batch_replace_gnd_records(file_list: list, input_dir: str, url: str, username: str, password: str):\n",
    "    \"\"\"Reads MARC XML files, extracts field 001 PPN, and executes SRU REPLACE requests.\"\"\"\n",
    "    headers = {\"Content-Type\": \"text/xml; charset=utf-8\"}\n",
    "    namespaces_res = {\n",
    "        \"ucp\": \"http://www.loc.gov/zing/srw/update/\",\n",
    "        \"diag\": \"http://www.loc.gov/zing/srw/diagnostic/\"\n",
    "    }\n",
    "\n",
    "    print(f\"Starting batch REPLACE for {len(file_list)} record(s)...\\n\")\n",
    "\n",
    "    for filename in file_list:\n",
    "        file_path = os.path.join(input_dir, filename)\n",
    "\n",
    "        if not os.path.exists(file_path):\n",
    "            print(f"[-] File {file_path} not found. Skipping...")\n",
    "            continue\n",
    "\n",
    "        try:\n",
    "            with open(file_path, \"r\", encoding=\"utf-8\") as f:\n",
    "                marc_record_str = f.read()\n",
    "\n",
    "            # Clean XML declaration\n",
    "            marc_record_str = re.sub(r'<\\?xml.*?\\?>', '', marc_record_str).strip()\n",
    "\n",
    "            # Extract PPN from controlfield 001\n",
    "            ppn_match = re.search(r'<controlfield tag=\"001\">(.*?)</controlfield>', marc_record_str)\n",
    "            if not ppn_match:\n",
    "                print(f"[-] Error: No PPN found in controlfield 001 for {filename}. Skipping...")\n",
    "                continue\n",
    "\n",
    "            target_ppn = ppn_match.group(1).strip()\n",
    "            print(f\"Sending REPLACE request for PPN {target_ppn} ({filename})...\")\n",
    "\n",
    "            soap_payload = SOAP_REPLACE_TEMPLATE.format(\n",
    "                target_ppn=target_ppn,\n",
    "                marc_record_str=marc_record_str,\n",
    "                username=username,\n",
    "                password=password\n",
    "            )\n",
    "\n",
    "            response = requests.post(\n",
    "                url,\n",
    "                data=soap_payload.encode(\"utf-8\"),\n",
    "                headers=headers,\n",
    "                auth=HTTPBasicAuth(username, password),\n",
    "                timeout=30\n",
    "            )\n",
    "\n",
    "            if response.status_code == 200:\n",
    "                res_root = ET.fromstring(response.text)\n",
    "                status = res_root.find(\".//ucp:operationStatus\", namespaces_res)\n",
    "\n",
    "                if status is not None and status.text == \"success\":\n",
    "                    print(f\"[+] Success! GND Record {target_ppn} updated successfully.\")\n",
    "                else:\n",
    "                    print(f\"[!] SRU Error for PPN {target_ppn}.\")\n",
    "                    msg = res_root.find(\".//diag:message\", namespaces_res)\n",
    "                    if msg is not None:\n",
    "                        print(f\"    Server Message: {msg.text}\")\n",
    "            else:\n",
    "                print(f\"[-] Server Error for PPN {target_ppn} (Status {response.status_code}).\")\n",
    "\n",
    "        except Exception as e:\n",
    "            print(f\"[-] Error processing {filename}: {e}\")\n",
    "\n",
    "        print(\"-\" * 50)\n",
    "\n",
    "    print(\"\\nBatch processing complete.\")\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# 2. CONFIGURATION & EXECUTION\n",
    "# ==========================================\n",
    "SRU_URL = \"https://devel.dnb.de/sru_ru/\"\n",
    "TEMPLATE_DIR = \"gnd_edit_templates\"\n",
    "FILES_TO_SEND = [\n",
    "    \"ppn_5018471824_clean.xml\",\n",
    "    \"ppn_5018471832_clean.xml\",\n",
    "    \"ppn_5018471840_clean.xml\"\n",
    "]\n",
    "\n",
    "# Credentials prompt\n",
    "USERNAME = os.getenv(\"SRU_USERNAME\") or input(\"Enter SRU Username: \")\n",
    "PASSWORD = os.getenv(\"SRU_PASSWORD\") or getpass.getpass(\"Enter SRU Password: \")\n",
    "\n",
    "batch_replace_gnd_records(\n",
    "    file_list=FILES_TO_SEND,\n",
    "    input_dir=TEMPLATE_DIR,\n",
    "    url=SRU_URL,\n",
    "    username=USERNAME,\n",
    "    password=PASSWORD\n",
    ")\n"
   ]
  }
